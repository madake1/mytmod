<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional machine-local override; never commit installation paths. -->
  <Import Project="Build.Local.props" Condition="Exists('Build.Local.props')" />
  <PropertyGroup>
    <TmlTargetsPath Condition="'$(TmlTargetsPath)' == ''">$(MSBuildProjectDirectory)\..\tModLoader.targets</TmlTargetsPath>
  </PropertyGroup>
  <!-- Import ModSources/tModLoader.targets or the installed game's tMLMod.targets.
       The sibling tModLoader source tree uses a different build workflow. -->
  <Import Project="$(TmlTargetsPath)" />
  <PropertyGroup>
    <AssemblyName>madake1</AssemblyName>
    <RootNamespace>madake1</RootNamespace>
  </PropertyGroup>
</Project>
